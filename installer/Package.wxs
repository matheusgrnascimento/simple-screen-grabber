<!--
  MSI installer for Simple Screen Grabber (WiX Toolset 5).
  Built by installer/build-installer.ps1, which stages the files in
  $(StageDir) and passes the version.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="Simple Screen Grabber"
           Manufacturer="Matheus Nascimento"
           Version="$(Version)"
           UpgradeCode="8DC426C3-8611-4857-A530-0935CB614078"
           Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Simple Screen Grabber is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AppIcon.ico" SourceFile="$(StageDir)\icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/matheusgrnascimento/simple-screen-grabber" />
    <WixVariable Id="WixUILicenseRtf" Value="$(StageDir)\license.rtf" />

    <!-- The Advanced button of the first page lets the user choose between
         all users (the default: Program Files, asks for administrator
         rights) and the current user only (%LocalAppData%\Programs, no
         prompt). WixUI_Advanced would use the 32-bit Program Files and
         %LocalAppData%\Apps, so both folders are set again after its
         defaults. -->
    <Property Id="ApplicationFolderName" Value="Simple Screen Grabber" />
    <Property Id="WixAppFolder" Value="WixPerMachineFolder" />
    <CustomAction Id="SetPerUserFolder"
                  Property="WixPerUserFolder"
                  Value="[LocalAppDataFolder]Programs\[ApplicationFolderName]"
                  Execute="immediate" />
    <CustomAction Id="SetPerMachineFolder"
                  Property="WixPerMachineFolder"
                  Value="[ProgramFiles64Folder][ApplicationFolderName]"
                  Execute="immediate" />
    <InstallUISequence>
      <Custom Action="SetPerUserFolder" After="WixSetDefaultPerMachineFolder" />
      <Custom Action="SetPerMachineFolder" After="SetPerUserFolder" />
    </InstallUISequence>
    <!-- Start with Windows: on by default (START_WITH_WINDOWS=0 turns it
         off in a silent install). An upgrade keeps it off if the user
         turned it off from the tray menu. -->
    <Property Id="START_WITH_WINDOWS" Value="1" />
    <Property Id="EXISTING_AUTOSTART">
      <RegistrySearch Id="ExistingAutostart"
                      Root="HKCU"
                      Key="Software\Microsoft\Windows\CurrentVersion\Run"
                      Name="SimpleScreenGrabber"
                      Type="raw" />
    </Property>
    <SetProperty Id="START_WITH_WINDOWS"
                 Value="0"
                 After="AppSearch"
                 Sequence="both"
                 Condition="WIX_UPGRADE_DETECTED AND NOT EXISTING_AUTOSTART" />

    <!-- The app stays in the tray: close it before files are replaced or
         removed (it exits on WM_CLOSE). -->
    <util:CloseApplication Id="CloseRunningApp"
                           Target="Simple Screen Grabber.exe"
                           CloseMessage="yes"
                           RebootPrompt="no"
                           Timeout="5" />

    <!-- The final page offers to open the app. -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Open Simple Screen Grabber" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#MainExe]" />
    <CustomAction Id="LaunchApplication"
                  BinaryRef="Wix4UtilCA_X64"
                  DllEntry="WixShellExec"
                  Impersonate="yes" />
    <UI>
      <ui:WixUI Id="WixUI_Advanced" />
      <Publish Dialog="ExitDialog"
               Control="Finish"
               Event="DoAction"
               Value="LaunchApplication"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>

    <!-- Uninstalling removes Start with Windows even when it was turned on
         later from the tray menu, so no broken entry stays behind. Runs as
         the user, while the executable still exists. -->
    <CustomAction Id="DisableAutostart"
                  FileRef="MainExe"
                  ExeCommand="--disable-autostart"
                  Execute="immediate"
                  Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="SetPerUserFolder" After="WixSetDefaultPerMachineFolder" />
      <Custom Action="SetPerMachineFolder" After="SetPerUserFolder" />
      <Custom Action="DisableAutostart"
              Before="RemoveFiles"
              Condition="REMOVE = &quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="APPLICATIONFOLDER" Name="Simple Screen Grabber" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="Simple Screen Grabber" Level="1">
      <Component Directory="APPLICATIONFOLDER">
        <File Id="MainExe" Source="$(StageDir)\Simple Screen Grabber.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut"
                    Name="Simple Screen Grabber"
                    Description="Select an area of the screen, annotate it, save or copy it"
                    Directory="ProgramMenuFolder"
                    WorkingDirectory="APPLICATIONFOLDER"
                    Icon="AppIcon.ico"
                    Advertise="yes" />
        </File>
      </Component>
      <Component Directory="APPLICATIONFOLDER">
        <File Id="LicenseFile" Source="$(StageDir)\LICENSE.txt" KeyPath="yes" />
      </Component>
    </Feature>

    <!-- A feature of its own: the advertised shortcut checks only the Main
         feature, so launching the app never repairs (turns back on) Start
         with Windows after the user turned it off in the tray menu. -->
    <Feature Id="Autostart" Title="Start with Windows" Level="1">
      <Level Value="0" Condition="START_WITH_WINDOWS &lt;&gt; 1" />
      <Component Id="Autostart" Directory="APPLICATIONFOLDER">
        <RegistryValue Root="HKCU"
                       Key="Software\Microsoft\Windows\CurrentVersion\Run"
                       Name="SimpleScreenGrabber"
                       Type="string"
                       Value="&quot;[APPLICATIONFOLDER]Simple Screen Grabber.exe&quot; --autostart"
                       KeyPath="yes" />
      </Component>
    </Feature>
  </Package>
</Wix>
